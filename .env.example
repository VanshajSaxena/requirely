# Copy to .env. Node 24 loads it via process.loadEnvFile() — no dotenv package.

NODE_ENV=development
LOG_LEVEL=info

# Required from Phase 3 (storage) onward. `docker compose up -d` serves this.
DATABASE_URL=postgres://requirely:requirely@localhost:5432/requirely

# Provider credentials. Only the providers actually selected below are required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Capability -> provider mapping. These are deliberately independent: the
# architecture allows different vendors at different layers, so reasoning and
# transcription are configured separately rather than sharing one provider.
REQUIRELY_REASONING_PROVIDER=anthropic
REQUIRELY_REASONING_MODEL=claude-opus-5

REQUIRELY_TRANSCRIPTION_PROVIDER=openai
REQUIRELY_TRANSCRIPTION_MODEL=whisper-1

# Question volume is a cost, not a feature: the loop must finalize within this
# many questions or report that it could not reach sufficiency.
REQUIRELY_QUESTION_BUDGET=12

# A turn that asks everything at once is a questionnaire, not a loop.
REQUIRELY_MAX_QUESTIONS_PER_TURN=4

# separate = 3 model calls/turn; assess scores the understanding actually stored.
# merged   = 2 model calls/turn; sends the understanding once and scores a
#            predicted merge. Saves exactly the size of the compact projection
#            per turn — negligible on a small session, material on a mature one.
REQUIRELY_TURN_STRATEGY=separate
