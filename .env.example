# Copy to .env. Node 24 loads it via process.loadEnvFile() — no dotenv package.

NODE_ENV=development
LOG_LEVEL=info

# Required from Phase 3 (storage) onward. `docker compose up -d` serves this.
DATABASE_URL=postgres://requirely:requirely@localhost:5432/requirely

# Host port for the docker-compose Postgres. Change BOTH this and the port in
# DATABASE_URL together when 5432 is already taken by a native server — a very
# common case on Linux, where a distro or Nix module may run one as a service.
# `docker compose` reads this same file, so setting it here is all it takes.
REQUIRELY_DB_PORT=5432

# Provider credentials. Only the providers actually selected below are required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Capability -> provider mapping. These are deliberately independent: the
# architecture allows different vendors at different layers, so reasoning and
# transcription are configured separately rather than sharing one provider.
# anthropic | openai | google | deepseek | fake
# Cost varies by roughly an order of magnitude across these; a measured
# claude-haiku-4-5 turn was ~$0.14, and a Gemini Flash turn is cents.
# `fake` needs the CLI's --script flag to do anything at all.
REQUIRELY_REASONING_PROVIDER=anthropic
REQUIRELY_REASONING_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Model ids — each one below was CALLED through this codebase's own adapter on
# 2026-09-16, not read off a docs page and not recalled. `OK` means it returned
# a valid structured response in `constrained` mode with zero repairs.
#
# Why the calls and not just the list: a provider's model-list endpoint reports
# what your key can SEE, not what it can USE. Three Gemini ids below are listed
# and rejected on first call.
#
# Re-check with:
#   curl -s https://api.openai.com/v1/models \
#     -H "Authorization: Bearer $OPENAI_API_KEY" | jq -r '.data[].id' | sort
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY&pageSize=200" \
#     | jq -r '.models[] | select(.supportedGenerationMethods[]? == "generateContent") | .name'
#
# anthropic ── ids are complete as written; never append a date suffix
#   claude-fable-5-1          most capable — see the caveat at the bottom
#   claude-opus-5
#   claude-sonnet-5
#   claude-haiku-4-5          measured ~$0.14/turn, the only priced non-Anthropic-free option
#
# openai ── all four verified OK
#   gpt-6-astra               OK
#   gpt-5.6-sol               OK
#   gpt-5.6-luna              OK
#   gpt-5.6-terra             OK
#   (also listed: gpt-5.5, gpt-5.4 and their -pro / -mini / -nano / -codex /
#    -chat-latest variants — 130 ids in total, untested here.)
#
# google ── RETIRED FOR NEW KEYS, listed but rejected on first call:
#   gemini-2.5-flash-lite     -> use gemini-3.5-flash-lite
#   gemini-2.5-flash          -> use gemini-3.6-flash
#   gemini-2.5-pro            -> use gemini-3.1-pro-preview
#
# google ── verified OK
#   gemini-3.8-flash          OK
#   gemini-3.5-flash-lite     OK   (the 2.5-flash-lite replacement)
#   gemini-3.1-flash-lite     OK
#   gemini-3-flash-preview    OK
#   (also listed: gemini-3.7-flash, gemini-3.6-flash, gemini-3.1-pro-preview,
#    and the -latest aliases. The -image / -tts / -transcribe siblings are other
#    modalities and will not work here.)
#
# deepseek ── no key set; DeepSeek has no schema-constrained decoding, so
#             `chooseMethod` degrades it to tool mode automatically.
#
# Two things to know before comparing these:
#
# 1. Costs are real for every id above. `adapters/ai/pricing.ts` carries
#    Anthropic (verified 2026-08-28) plus OpenAI and Google (2026-09-15), read
#    off each vendor's pricing page. Only DeepSeek takes the `null` path and
#    reports "cost unknown" — no key is set for it here anyway.
#
#    One caveat with a date on it: gemini-3.6-flash and gemini-3.8-flash are
#    priced at their current $0.75/$3.75, which Google has published as rising
#    to $1.50/$7.50 on 2027-01-01. That change is declared in
#    `SCHEDULED_PRICE_CHANGES` and `pricing.test.ts` fails once the date passes,
#    so it cannot rot unnoticed.
#
# 2. `claude-fable-5-1` rejects forced tool use with a 400. `chooseMethod` picks
#    tool mode only when a schema exceeds the grammar caps, and ours measure
#    0 optional / 0 union — so it should never fire. If it ever does, that model
#    fails outright rather than degrading. It also requires 30-day retention.
# ---------------------------------------------------------------------------

# openai = real transcription (needs OPENAI_API_KEY)
# none   = audio ingestion unavailable; ingestAudio fails with a clear error
# fake   = scripted text, for tests only — never for a real session
REQUIRELY_TRANSCRIPTION_PROVIDER=none
REQUIRELY_TRANSCRIPTION_MODEL=whisper-1

# Question volume is a cost, not a feature: the loop must finalize within this
# many questions or report that it could not reach sufficiency.
REQUIRELY_QUESTION_BUDGET=12

# A turn that asks everything at once is a questionnaire, not a loop.
REQUIRELY_MAX_QUESTIONS_PER_TURN=4

# separate = 3 model calls/turn; assess scores the understanding actually stored.
# merged   = 2 model calls/turn; sends the understanding once and scores a
#            predicted merge. Saves exactly the size of the compact projection
#            per turn — negligible on a small session, material on a mature one.
REQUIRELY_TURN_STRATEGY=separate
