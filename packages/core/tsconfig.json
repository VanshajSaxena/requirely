{
  "extends": "../../tsconfig.base.json",

  // Everything below is a claim about the runtime: "this package is executed by
  // Node 24, which strips types rather than compiling them." None of it may be
  // inherited by a bundled or browser package — see tsconfig.base.json.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Also asserts that no DOM exists, and makes `process`/`Buffer` global.
    // Inheriting this would silently permit Node APIs in a browser bundle.
    "types": ["node"],

    // Node 24 runs .ts directly by stripping types. Only erasable syntax survives
    // that, so the compiler enforces it here rather than letting it fail at runtime:
    // no `enum`, no parameter properties, no `namespace`. Use `as const` + a union type.
    "erasableSyntaxOnly": true,

    // Relative imports carry the .ts extension so Node can resolve them unbuilt.
    // TypeScript rejects allowImportingTsExtensions unless emit is off, so these
    // three and `noEmit` are one unit — do not separate them.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "noEmit": true
  },
  "include": ["src/**/*.ts", "*.config.ts", "scripts/**/*.ts"]
}
