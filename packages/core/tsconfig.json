{
  "extends": "../../tsconfig.base.json",

  // Everything below is a claim about the runtime: "this package is executed by
  // Node 24, which strips types rather than compiling them." None of it may be
  // inherited by a bundled or browser package — see tsconfig.base.json.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Also asserts that no DOM exists, and makes `process`/`Buffer` global.
    // Inheriting this would silently permit Node APIs in a browser bundle.
    "types": ["node"],

    // Node 24 runs .ts directly by stripping types. Only erasable syntax survives
    // that, so the compiler enforces it here rather than letting it fail at runtime:
    // no `enum`, no parameter properties, no `namespace`. Use `as const` + a union type.
    "erasableSyntaxOnly": true,

    // Relative imports carry the .ts extension because Node's ESM resolver needs the
    // exact on-disk filename. Verified on 24.19: './answer.js' and extensionless both
    // give ERR_MODULE_NOT_FOUND, and --experimental-transform-types does not change it.
    // Node's resolver contains no reference to .ts at all — its TS support is an
    // extension->format table plus amaro.transformSync, neither of which reads specifiers.
    //
    // TS5096 permits allowImportingTsExtensions when ANY of `noEmit`,
    // `emitDeclarationOnly`, or `rewriteRelativeImportExtensions` is set. `noEmit`
    // satisfies it here.
    "allowImportingTsExtensions": true,

    // Inert today: with `noEmit` there is no output to rewrite. Kept because it is the
    // flag that makes adding a build a config-only change — see the build trigger in
    // this package's CLAUDE.md. It is what lets emit coexist with .ts specifiers.
    "rewriteRelativeImportExtensions": true,

    "noEmit": true
  },
  "include": ["src/**/*.ts", "*.config.ts", "scripts/**/*.ts"]
}
