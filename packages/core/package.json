{
  "name": "@requirely/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The requirement-gathering loop: domain model, engine, adapters, ingestion and config.",
  "engines": {
    "node": ">=24.12.0"
  },
  "exports": {
    "./domain": "./src/domain/index.ts"
  },
  "scripts": {
