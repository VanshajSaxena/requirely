{
  "name": "requirely",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns unstructured input into a structured understanding of what needs to be built.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "pnpm --filter @requirely/core run typecheck",
    "boundaries": "pnpm --filter @requirely/core run boundaries",
    "test": "pnpm --filter @requirely/core run test",
    "test:watch": "pnpm --filter @requirely/core run test:watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @requirely/core run db:generate",
    "db:migrate": "pnpm --filter @requirely/core run db:migrate",
    "db:studio": "pnpm --filter @requirely/core run db:studio",
    "verify": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "typescript": "^7.0.2"
  }
}
