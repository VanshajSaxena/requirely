{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "types": ["node", "react", "react-dom"],

    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "incremental": true,
    "noEmit": true,

    // Explicitly OFF, not merely un-inherited. tsconfig.base.json does not set
    // these today, but stating them here means a future edit to the base cannot
    // silently impose Node's type-stripping rules on a bundled React app:
    //   erasableSyntaxOnly    bans enum/parameter properties — meaningless under SWC
    //   rewriteRelative…      rewrites .ts -> .js on emit — fights Next's transform
    // Enabled for a reason that is NOT about this app's own code, which never
    // writes .ts specifiers. There is no TS project boundary between packages
    // (project references are impossible here — composite conflicts with noEmit),
    // so tsc checks @requirely/core's files using THIS config, and core's files
    // are full of `from './x.ts'` to satisfy Node's type stripping. Without this,
    // every shared domain file fails with TS5097.
    // Its prerequisite, noEmit, is set above.
    "allowImportingTsExtensions": true,

    "erasableSyntaxOnly": false,
    "rewriteRelativeImportExtensions": false,

    "plugins": [{ "name": "next" }],

    "paths": {
      "@/*": ["./*"],
      "@requirely/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
