{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "types": ["node", "react", "react-dom"],

    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "incremental": true,
    "noEmit": true,

    // Explicitly OFF, not merely un-inherited. tsconfig.base.json does not set
    // these today, but stating them here means a future edit to the base cannot
    // silently impose Node's type-stripping rules on a bundled React app:
    //   erasableSyntaxOnly    bans enum/parameter properties — meaningless under SWC
    //   rewriteRelative…      rewrites .ts -> .js on emit — fights Next's transform
    "erasableSyntaxOnly": false,
    "rewriteRelativeImportExtensions": false,

    // `allowImportingTsExtensions` is deliberately ABSENT. It would only be needed
    // once @requirely/core is a dependency here: there is no TS project boundary, so
    // tsc would then check core's files with THIS config, and core's files carry
    // `.ts` specifiers for Node's type stripping. Until then it is dead config —
    // verified `tsc --noEmit --allowImportingTsExtensions false` exits 0, because
    // packages/ui/src has no relative imports at all.
    //
    // Note the distinction that made the original comment wrong: an exports-map
    // target that IS a .ts file resolves with no compiler flag whatsoever. The flag
    // only governs .ts specifiers written in source text. TS5097 names the flag in
    // its own message, so the day it is needed is self-evident.

    "plugins": [{ "name": "next" }],

    "paths": {
      "@/*": ["./*"],
      "@requirely/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
